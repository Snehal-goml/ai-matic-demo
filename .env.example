# -----------------------------------------------------------------------------
# AI-Powered Intelligent Document Extractor - Environment Configuration
# Copy to .env and fill in values. Never commit .env to version control.
# For production, use AWS Secrets Manager or SSM for API keys and JWT secret.
# -----------------------------------------------------------------------------

# --- Environment ---
ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=text
# LOG_FORMAT=json for production log aggregators

# --- AWS (required for AWS_textract extractor and LLM) ---
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# (Or use IAM role / instance profile in production)

#for textract
AWS_REGION=us-east-1
BUCKET_NAME=your-s3-bucket-name

#LLM
# LLM_PROVIDER= #bedrock / openai

#bedrock configuration (model id or application inference profile ARN)
MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0
# Nova 2 Sonic (speech-to-speech) application inference profile ARN (optional)
# NOVA_SONIC_MODEL_ID=arn:aws:bedrock:us-east-1:123456789012:application-inference-profile/xxxxxxxxxx


#openai
# OPENAI_API_KEY= "your openai api key"
# OPENAI_MODEL= "Your preferred model"

# --- Extractor (choose one) ---
# AWS_textract = AWS Textract + S3 (best accuracy; requires AWS)
# goml_custom_extractor = Local libraries (offline; no AWS for extraction)
EXTRACTOR_TYPE=AWS_textract

# --- File limits ---
MAX_FILE_SIZE_MB=100
MAX_PAGES_PER_REQUEST=50
CHUNK_SIZE_MB=10
MAX_BATCH_FILES=10

# --- Timeouts (seconds) ---
TEXTRACT_TIMEOUT=300
LLM_TIMEOUT=60
FILE_UPLOAD_TIMEOUT=120
SHUTDOWN_DRAIN_SECONDS=30

# --- Concurrency ---
MAX_WORKERS=4
MAX_CONCURRENT_PAGES=5

# --- S3 ---
S3_PREFIX=document-uploads
S3_TEMP_EXPIRY_DAYS=1

# --- Retries ---
MAX_RETRIES=3
RETRY_DELAY=1.0

# --- Health (optional dependency checks in readiness) ---
# HEALTH_CHECK_S3=false
# HEALTH_CHECK_BEDROCK=false

# --- Auth: none | api_key | bearer | jwt ---
AUTH_METHOD=none
# API_KEY=single-key
# API_KEYS=key1,key2,key3
# BEARER_TOKEN=your-bearer-token
# JWT_SECRET=your-jwt-secret
# JWT_ALGORITHM=HS256

# --- Rate limiting ---
# RATE_LIMIT_ENABLED=false
# RATE_LIMIT_PER_MINUTE=60

# --- Input hardening: comma-separated MIME types; empty = no check ---
# ALLOWED_UPLOAD_CONTENT_TYPES=application/pdf,image/png,image/jpeg
# --- RAG bundle (vector store = qdrant, strategy = naive) ---
DEFAULT_RAG_TYPE=naive
DEFAULT_VECTOR_STORE=qdrant
DEFAULT_TOP_K=10
DEFAULT_SCORE_THRESHOLD=0.0
DEFAULT_VECTOR_DIM=1536
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200

# Qdrant connection (defaults are local dev friendly)
# QDRANT_URL=http://localhost
# QDRANT_PORT=6333
# QDRANT_API_KEY=

# Embedding model (used by Naive RAG for semantic search; Bedrock Titan text embeddings)
# EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
